{
  "name": "web-mudanzas-c-simon",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles.css -o ./css/styles.css --minify",
    "build": "npm run build:css && eleventy",
    "dev": "npm run build:css && concurrently -k -n css,web \"tailwindcss -i ./src/styles.css -o ./css/styles.css --watch\" \"eleventy --serve --port=8080\"",
    "build:img": "python scripts/optimizar-imagenes.py"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "concurrently": "^10.0.7",
    "html-validate": "^11.0.0",
    "tailwindcss": "^3.4.17"
  }
}
