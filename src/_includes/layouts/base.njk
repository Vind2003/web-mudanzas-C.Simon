{%- from "macros.njk" import foto, flecha, icono, estrellas with context -%}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  {#- Consentimiento de cookies: va primero y sin defer para decidir si se carga Analytics #}
  <script src="/js/consent.js?v={{ assets.consent }}"></script>
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#ffffff" />
  <link rel="preload" href="/fonts/hanken-grotesk-var.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/css/styles.css?v={{ assets.css }}" />
  {%- if hero and hero.foto %}
  <link rel="preload" as="image" href="/fotos/web/{{ hero.foto }}-640.webp" imagesrcset="/fotos/web/{{ hero.foto }}-640.webp {{ fotos[hero.foto].w640 }}w{% if fotos[hero.foto].w960 > fotos[hero.foto].w640 %}, /fotos/web/{{ hero.foto }}-960.webp {{ fotos[hero.foto].w960 }}w{% endif %}{% if fotos[hero.foto].w1200 > fotos[hero.foto].w960 %}, /fotos/web/{{ hero.foto }}-1200.webp {{ fotos[hero.foto].w1200 }}w{% endif %}" imagesizes="(min-width: 1024px) 50vw, 100vw" fetchpriority="high" />
  {%- endif %}

  <title>{{ title }}</title>
  {%- if description %}
  <meta name="description" content="{{ description }}" />
  {%- endif %}
  {%- if noindex %}
  <meta name="robots" content="noindex, follow" />
  {%- else %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
  <meta name="robots" content="index, follow, max-image-preview:large" />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:site_name" content="{{ site.nombre }}" />
  <meta property="og:title" content="{{ title }}" />
  <meta property="og:description" content="{{ description }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:image" content="{{ site.url }}/fotos/og/{{ ogImagen }}" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="{{ ogAlt }}" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title }}" />
  <meta name="twitter:description" content="{{ description }}" />
  <meta name="twitter:image" content="{{ site.url }}/fotos/og/{{ ogImagen }}" />
  {%- endif %}
  {%- if jsonld %}

  <script type="application/ld+json">
{{ jsonld | safe }}
  </script>
  {%- endif %}
</head>

<body class="flex min-h-screen flex-col">
  <a class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[1100] rounded-lg bg-primary px-3 py-2 text-white" href="#main">Saltar al contenido</a>

  {% include "partials/header.njk" %}

  <main id="main" class="flex-grow">
    {%- if hero %}
    {#- Primer bloque: foto real a sangre con degradado; el texto entra una sola vez al cargar #}
    <section class="ground-photo">
      <div class="fondo" data-enter-foto>{{ foto(hero.foto, "100vw", true) }}</div>
      <div class="wrap flex flex-col justify-end pb-14 pt-28 md:min-h-0 md:justify-center md:pb-24 md:pt-24 {% if esquema and esquema.tipo == 'inicio' %}min-h-[34rem] lg:min-h-[min(calc(100svh-5.5rem-6.5rem),44rem)]{% else %}min-h-[28rem] lg:min-h-[30rem]{% endif %}">
        <div class="max-w-[40rem]" data-enter>
          {%- if esquema and esquema.tipo != "inicio" %}
          <nav aria-label="Ruta de navegación" class="mb-4 text-base text-white/85">
            <a href="/" class="inline-flex min-h-11 items-center"><span class="link">Inicio</span></a>
            <span aria-hidden="true" class="mx-2">/</span>
            <span aria-current="page">{{ esquema.miga or esquema.nombre }}</span>
          </nav>
          {%- endif %}
          <h1>{{ hero.titulo }}</h1>
          <p class="lead mt-5">{{ hero.texto }}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#contacto" class="btn-cta">Pedir presupuesto gratis {{ flecha() }}</a>
            <a href="tel:{{ site.telefono }}" class="btn-light">{{ icono("telefono", "h-5 w-5") }} Llamar al {{ site.telefonoTexto }}</a>
          </div>
        </div>
      </div>
    </section>

    {#- Franja de confianza: solo datos reales #}
    <section aria-label="Por qué confiar en nosotros" class="border-b border-line bg-white">
      <ul class="wrap grid grid-cols-2 gap-x-5 gap-y-5 py-6 sm:gap-x-8 sm:py-7 lg:grid-cols-4">
        <li>
          <a href="{{ site.resenas }}" target="_blank" rel="noopener" class="group flex items-center gap-4">
            <span class="icono hidden sm:flex">{{ icono("estrella") }}</span>
            <span><span class="block font-semibold text-ink"><span class="link">{{ site.googleNota }} en Google</span></span><span class="block text-[0.9375rem] text-muted sm:text-base">{{ site.googleOpiniones }} opiniones<span class="sr-only"> (se abre en una pestaña nueva)</span></span></span>
          </a>
        </li>
        <li class="flex items-center gap-4"><span class="icono hidden sm:flex">{{ icono("casa") }}</span><span><span class="block font-semibold text-ink">Visita gratis</span><span class="block text-[0.9375rem] text-muted sm:text-base">Presupuesto sin compromiso</span></span></li>
        <li class="flex items-center gap-4"><span class="icono hidden sm:flex">{{ icono("mundo") }}</span><span><span class="block font-semibold text-ink">Locales y nacionales</span><span class="block text-[0.9375rem] text-muted sm:text-base">También internacionales</span></span></li>
        <li class="flex items-center gap-4"><span class="icono hidden sm:flex">{{ icono("idioma") }}</span><span><span class="block font-semibold text-ink">Español e inglés</span><span class="block text-[0.9375rem] text-muted sm:text-base">We speak English</span></span></li>
      </ul>
    </section>
    {%- endif %}

{{ content | safe }}

    {%- if faq %}
    <section class="section" id="preguntas">
      <div class="wrap grid gap-8 lg:grid-cols-12 lg:gap-6">
        <div class="lg:col-span-4 lg:pr-8">
          <h2>{{ faqTitulo or "Preguntas frecuentes" }}</h2>
          <p class="mt-4">¿No encuentras tu duda? <a href="tel:{{ site.telefono }}" class="link-text">Llámanos al {{ site.telefonoTexto }}</a>.</p>
        </div>
        <div class="faq border-t border-line lg:col-span-8">
          {%- for f in faq %}
          <details{% if loop.first %} open{% endif %}>
            <summary>{{ f.p }}{{ icono("mas", "mas") }}</summary>
            <div><p>{{ f.r }}</p></div>
          </details>
          {%- endfor %}
        </div>
      </div>
    </section>
    {%- endif %}

    {%- if contacto %}
    {% include "partials/contacto.njk" %}
    {%- endif %}
  </main>

  {% include "partials/footer.njk" %}
  {% include "partials/whatsapp.njk" %}

  <script src="/js/site.js?v={{ assets.site }}" defer></script>
</body>
</html>
