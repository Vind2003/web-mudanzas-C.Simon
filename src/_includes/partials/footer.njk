{#- Pie común: contacto, servicios, zonas y enlaces legales #}
{%- from "macros.njk" import estrellas with context -%}
<footer class="ground-dark mt-auto pb-28 pt-16 md:pb-12">
  <div class="wrap">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-12 lg:gap-6">

      <div class="lg:col-span-4">
        <a href="/" class="flex items-center gap-3">
          <img src="/fotos/web/logo-168.webp" width="112" height="168" alt="" class="h-14 w-auto rounded-md" loading="lazy">
          <span class="text-2xl font-bold tracking-tight text-white">Mudanzas C.Simon</span>
        </a>
        <a href="{{ site.resenas }}" target="_blank" rel="noopener" class="mt-5 inline-flex min-h-11 items-center gap-2 text-white">{{ estrellas("h-4 w-4") }}<span class="link">{{ site.googleNota }} en Google · {{ site.googleOpiniones }} opiniones</span><span class="sr-only"> (se abre en una pestaña nueva)</span></a>
        <p class="mt-1 text-base text-slate-300">¿Ya te hemos hecho la mudanza? <a href="{{ site.escribirResena }}" target="_blank" rel="noopener" class="font-semibold text-white underline underline-offset-4 hover:no-underline">Déjanos tu opinión<span class="sr-only"> (se abre en una pestaña nueva)</span></a></p>
        <address class="mt-4 not-italic">
          Estepona, Málaga<br>
          <a href="tel:{{ site.telefono }}" class="inline-flex min-h-11 items-center text-white"><span class="link">{{ site.telefonoTexto }}</span></a><br>
          <a href="mailto:{{ site.email }}" class="inline-flex min-h-11 items-center break-all text-white"><span class="link">{{ site.email }}</span></a>
        </address>
        <div class="mt-4 flex gap-3">
          <a href="{{ site.facebook }}" target="_blank" rel="noopener" class="flex h-11 w-11 items-center justify-center rounded-full border border-white/20 text-white transition-colors hover:border-white/50" aria-label="Facebook (se abre en una pestaña nueva)">
            <svg aria-hidden="true" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"></path></svg>
          </a>
          <a href="{{ site.instagram }}" target="_blank" rel="noopener" class="flex h-11 w-11 items-center justify-center rounded-full border border-white/20 text-white transition-colors hover:border-white/50" aria-label="Instagram (se abre en una pestaña nueva)">
            <svg aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
        </div>
      </div>

      <nav aria-label="Servicios" class="lg:col-span-3 lg:col-start-6">
        <h2 class="text-base font-semibold !text-slate-300">Servicios</h2>
        <ul class="mt-3">
          {%- for s in site.servicios %}
          <li><a href="{{ s.url }}" class="inline-flex min-h-11 items-center text-white"><span class="link">{{ s.titulo }}</span></a></li>
          {%- endfor %}
        </ul>
      </nav>

      <nav aria-label="Zonas" class="lg:col-span-2">
        <h2 class="text-base font-semibold !text-slate-300">Zonas</h2>
        <ul class="mt-3">
          <li><a href="/" class="inline-flex min-h-11 items-center text-white"><span class="link">Estepona</span></a></li>
          {%- for z in site.zonas %}
          <li><a href="{{ z.url }}" class="inline-flex min-h-11 items-center text-white"><span class="link">{{ z.corto }}</span></a></li>
          {%- endfor %}
          <li><a href="/#zonas" class="inline-flex min-h-11 items-center text-white"><span class="link">Costa del Sol</span></a></li>
        </ul>
      </nav>

      <nav aria-label="Legal" class="lg:col-span-2">
        <h2 class="text-base font-semibold !text-slate-300">Legal</h2>
        <ul class="mt-3">
          <li><a href="/aviso-legal/" class="inline-flex min-h-11 items-center text-white"{% if nav == 'aviso' %} aria-current="page"{% endif %}><span class="link">Aviso legal</span></a></li>
          <li><a href="/politica-privacidad/" class="inline-flex min-h-11 items-center text-white"{% if nav == 'privacidad' %} aria-current="page"{% endif %}><span class="link">Privacidad</span></a></li>
          <li><a href="/politica-cookies/" class="inline-flex min-h-11 items-center text-white"{% if nav == 'cookies' %} aria-current="page"{% endif %}><span class="link">Cookies</span></a></li>
          <li><button type="button" data-cookie-settings class="inline-flex min-h-11 items-center text-white"><span class="link">Configurar cookies</span></button></li>
        </ul>
      </nav>
    </div>

    <p class="mt-12 border-t border-white/10 pt-6 text-sm text-slate-400">© {{ site.year }} Mudanzas C.Simon. Todos los derechos reservados.</p>
  </div>
</footer>
