{#- Bloque de contacto común. Cada página lo configura con su variable "contacto" (ver README). #}
{%- from "macros.njk" import foto, flecha, icono with context -%}
{%- macro campo(id, nombre, etiqueta, tipo="text", obligatorio=false, placeholder="", autocomplete="", maxlength=120, extra="") -%}
<div>
  <label for="{{ id }}" class="field-label">{{ etiqueta }}{% if obligatorio %} <span class="text-accent-text" aria-hidden="true">*</span>{% endif %}</label>
  <input id="{{ id }}" name="{{ nombre }}" type="{{ tipo }}" class="field"{% if placeholder %} placeholder="{{ placeholder }}"{% endif %}{% if autocomplete %} autocomplete="{{ autocomplete }}"{% endif %} maxlength="{{ maxlength }}"{% if obligatorio %} required{% endif %} {{ extra | safe }}>
  <p id="{{ id }}-error" class="field-error hidden"></p>
</div>
{%- endmacro %}
{%- set waUrl = site.whatsapp + "?text=" + (waTexto or "Hola, me interesa un presupuesto para una mudanza") | urlencode %}

<section id="contacto" class="section ground-sky">
  <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-6">
    <div class="lg:col-span-7 lg:pr-10">
      <h2>{{ contacto.titulo }}</h2>
      {%- for texto in contacto.textos %}
      <p class="lead {% if loop.first %}mt-5{% else %}mt-2{% endif %}">{{ texto }}</p>
      {%- endfor %}

      <form action="{{ site.formspree }}" method="POST" data-form class="mt-10 space-y-6 rounded-2xl border border-line bg-white p-6 text-body shadow-[0_24px_60px_-36px_rgb(15_27_45/0.45)] md:p-9">
        <input type="hidden" name="_subject" value="Nueva solicitud web: {{ contacto.asunto }}">
        <input type="hidden" name="pagina" value="{{ contacto.asunto }}">
        {#- Campo trampa: las personas no lo ven; si un robot lo rellena, Formspree descarta el envío #}
        <div class="hidden" aria-hidden="true">
          <label for="f-web">No rellenes este campo</label>
          <input id="f-web" type="text" name="_gotcha" tabindex="-1" autocomplete="off">
        </div>

        <p class="text-base text-muted">Los campos con <span class="text-accent-text" aria-hidden="true">*</span><span class="sr-only">asterisco</span> son obligatorios.</p>

        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
          {{ campo("f-nombre", "name", "Nombre", obligatorio=true, placeholder="Tu nombre", autocomplete="name", maxlength=80) }}
          {{ campo("f-telefono", "phone", "Teléfono", tipo="tel", obligatorio=true, placeholder="600 000 000", autocomplete="tel", maxlength=20, extra='inputmode="tel" pattern="[0-9 +.\\(\\)\\-]{9,20}"') }}
        </div>

        {{ campo("f-email", "email", "Correo electrónico", tipo="email", obligatorio=true, placeholder="tu@email.com", autocomplete="email") }}

        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
          {%- if contacto.vivienda %}
          <div>
            <label for="f-vivienda" class="field-label">Tipo de inmueble</label>
            <select id="f-vivienda" name="tipo_inmueble" class="field">
              <option value="">Selecciona una opción</option>
              <option>Piso</option>
              <option>Casa o chalet</option>
              <option>Oficina o local</option>
              <option>Trastero o garaje</option>
              <option>Otro</option>
            </select>
          </div>
          {%- endif %}
          {{ campo("f-fecha", "fecha_aproximada", "Fecha aproximada", placeholder="Ej.: mediados de marzo", autocomplete="off", maxlength=60) }}
          {%- if contacto.extra %}
          <div{% if contacto.vivienda %} class="md:col-span-2"{% endif %}>
            {{ campo("f-" + contacto.extra.id, contacto.extra.nombre, contacto.extra.etiqueta, placeholder=contacto.extra.placeholder, autocomplete=contacto.extra.autocomplete or "off", maxlength=150) }}
          </div>
          {%- endif %}
        </div>

        <div>
          <label for="f-detalles" class="field-label">{{ contacto.mensaje.etiqueta }} <span class="text-accent-text" aria-hidden="true">*</span></label>
          <textarea id="f-detalles" name="message" class="field h-32 resize-none" placeholder="{{ contacto.mensaje.placeholder }}" maxlength="2000" required></textarea>
          <p id="f-detalles-error" class="field-error hidden"></p>
        </div>

        <div>
          <div class="flex items-start gap-3">
            <input type="checkbox" name="privacy_accepted" required id="privacy" class="mt-1 h-5 w-5 cursor-pointer accent-primary">
            <label for="privacy" class="cursor-pointer text-base text-muted">
              He leído y acepto la <a href="/politica-privacidad/" target="_blank" rel="noopener" class="link-text">política de privacidad</a> y el tratamiento de mis datos para recibir el presupuesto. <span class="text-accent-text" aria-hidden="true">*</span>
            </label>
          </div>
          <p id="privacy-error" class="field-error hidden"></p>
        </div>

        <button type="submit" class="btn-cta w-full text-lg">
          <span data-form-texto>Enviar solicitud</span> {{ flecha() }}
        </button>

        <div data-form-estado class="hidden rounded-lg p-4 text-sm" tabindex="-1"></div>
      </form>
    </div>

    <aside aria-label="Datos de contacto" class="lg:col-span-5">
      <div class="lg:sticky lg:top-28">
        <h3>Contacto directo</h3>
        <ul class="mt-6 space-y-3">
          <li>
            <a href="tel:{{ site.telefono }}" class="card flex items-center gap-4 p-5">
              <span class="icono">{{ icono("telefono") }}</span>
              <span><span class="block text-base text-muted">Llámanos</span><span class="block text-xl font-bold text-ink">{{ site.telefonoTexto }}</span></span>
            </a>
          </li>
          <li>
            <a href="{{ waUrl }}" target="_blank" rel="noopener" class="card flex items-center gap-4 p-5">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#25D366] text-white"><svg aria-hidden="true" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg></span>
              <span><span class="block text-base text-muted">WhatsApp</span><span class="block text-xl font-bold text-ink">Escríbenos</span><span class="sr-only"> (se abre en una pestaña nueva)</span></span>
            </a>
          </li>
          <li>
            <a href="mailto:{{ site.email }}" class="card flex items-center gap-4 p-5">
              <span class="icono"><svg aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3.5 7l8.5 6 8.5-6"/></svg></span>
              <span class="min-w-0"><span class="block text-base text-muted">Correo</span><span class="block break-all text-lg font-semibold text-ink">{{ site.email }}</span></span>
            </a>
          </li>
        </ul>
        <div class="frame mt-6 hidden aspect-[4/3] lg:block">{{ foto(contacto.foto or "camion-lleno", "(min-width: 1024px) 35vw, 100vw") }}</div>
      </div>
    </aside>
  </div>
</section>
