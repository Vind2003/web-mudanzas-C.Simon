{#- Cabecera común: fija, opaca y con una línea fina debajo. En móvil, botón de menú. #}
<header class="sticky top-0 z-50 border-b border-line bg-white">
  <div class="wrap flex min-h-[4.5rem] flex-wrap items-center justify-between gap-x-6">
    <a href="/" class="flex items-center gap-3 py-2">
      <img src="/fotos/web/logo-168.webp" width="112" height="168" alt="" class="h-11 w-auto rounded-md">
      <span class="text-lg font-medium leading-tight tracking-tight text-ink">Mudanzas C.Simon</span>
    </a>

    <button type="button" data-menu-toggle aria-expanded="false" aria-controls="menu-principal"
            class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-ink/20 text-ink lg:hidden">
      <svg data-menu-icon="abrir" aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
      <svg data-menu-icon="cerrar" aria-hidden="true" class="hidden h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
      <span class="sr-only">Menú</span>
    </button>

    <nav id="menu-principal" aria-label="Principal" class="hidden w-full lg:block lg:w-auto">
      <ul class="flex flex-col border-t border-line py-3 text-[0.9375rem] font-medium text-ink lg:flex-row lg:items-center lg:gap-7 lg:border-0 lg:py-0">
        {%- for item in site.nav %}
        <li>
          <a href="{{ item.url }}" class="flex min-h-14 items-center lg:min-h-0"{% if nav == item.clave %} aria-current="page"{% endif %}><span class="link">{{ item.texto }}</span></a>
        </li>
        {%- endfor %}
        <li class="lg:ml-3">
          <a href="tel:{{ site.telefono }}" class="flex min-h-14 items-center lg:min-h-0"><span class="link">{{ site.telefonoTexto }}</span></a>
        </li>
        <li class="pb-2 pt-2 lg:p-0">
          <a href="{% if contacto %}#contacto{% else %}/#contacto{% endif %}" class="btn-primary w-full lg:w-auto">Pedir presupuesto</a>
        </li>
      </ul>
    </nav>
  </div>
</header>
