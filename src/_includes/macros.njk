{#- Piezas reutilizables. Se importan así en cada página:
    {% from "macros.njk" import foto, flecha, galeria, filas, icono, estrellas with context %} -#}

{#- Foto optimizada: tamaños del manifiesto (src/_data/fotos.json) y texto alternativo de alts.json -#}
{% macro foto(nombre, sizes="(min-width: 1024px) 50vw, 100vw", prioridad=false, alt="") -%}
{%- set f = fotos[nombre] -%}
<img src="/fotos/web/{{ nombre }}-640.webp" srcset="/fotos/web/{{ nombre }}-640.webp {{ f.w640 }}w{% if f.w960 > f.w640 %}, /fotos/web/{{ nombre }}-960.webp {{ f.w960 }}w{% endif %}{% if f.w1200 > f.w960 %}, /fotos/web/{{ nombre }}-1200.webp {{ f.w1200 }}w{% endif %}" sizes="{{ sizes }}" width="{{ f.w640 }}" height="{{ f.h640 }}" alt="{{ alt or alts[nombre] }}"{% if prioridad %} fetchpriority="high"{% else %} loading="lazy" decoding="async"{% endif %}>
{%- endmacro %}

{#- Flecha de los enlaces y botones; avanza 3 px al pasar el ratón -#}
{% macro flecha() -%}
<svg class="m-arrow h-5 w-5 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/></svg>
{%- endmacro %}

{#- Iconos de línea propios, todos con el mismo trazo (1.75) y en 24x24 -#}
{% macro icono(nombre, clase="") -%}
<svg class="{{ clase }}" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
{%- if nombre == "estrella" %}<path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>
{%- elif nombre == "casa" %}<path d="M4 11l8-6.5 8 6.5"/><path d="M6 9.5V20h12V9.5"/><path d="M10 20v-5h4v5"/>
{%- elif nombre == "mundo" %}<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17"/><path d="M12 3.5c2.4 2.4 3.5 5.2 3.5 8.5s-1.1 6.1-3.5 8.5c-2.4-2.4-3.5-5.2-3.5-8.5S9.6 5.9 12 3.5z"/>
{%- elif nombre == "idioma" %}<path d="M4 5.5h10.5a1.5 1.5 0 011.5 1.5v6a1.5 1.5 0 01-1.5 1.5H9l-3.5 3v-3H4A1.5 1.5 0 012.5 13V7A1.5 1.5 0 014 5.5z"/><path d="M18 9.5h1.5A1.5 1.5 0 0121 11v5.5a1.5 1.5 0 01-1.5 1.5H19v2.5L16 18h-4"/>
{%- elif nombre == "telefono" %}<path d="M5 4.5h3l1.5 4-2 1.2a10 10 0 005 5l1.2-2 4 1.5v3a1.8 1.8 0 01-1.8 1.8A14.2 14.2 0 013.2 6.3 1.8 1.8 0 015 4.5z"/>
{%- elif nombre == "familia" %}<circle cx="8.5" cy="8" r="3"/><circle cx="16.5" cy="9" r="2.5"/><path d="M3 19.5c0-3 2.5-5.5 5.5-5.5s5.5 2.5 5.5 5.5"/><path d="M14.5 14.3c.6-.2 1.3-.3 2-.3 2.5 0 4.5 2 4.5 4.5"/>
{%- elif nombre == "cajas" %}<path d="M3.5 8.5L12 4l8.5 4.5v7L12 20l-8.5-4.5z"/><path d="M3.5 8.5L12 13l8.5-4.5"/><path d="M12 13v7"/>
{%- elif nombre == "fragil" %}<path d="M8 3.5h8l-.8 6.2A3.2 3.2 0 0112 12.5a3.2 3.2 0 01-3.2-2.8z"/><path d="M12 12.5v6"/><path d="M8.5 20.5h7"/>
{%- elif nombre == "camion" %}<path d="M2.5 6.5h11v9h-11z"/><path d="M13.5 9.5h4l3 3v3h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
{%- elif nombre == "mas" %}<path d="M12 5v14M5 12h14"/>
{%- elif nombre == "check" %}<path d="M5 12.5l4.5 4.5L19 7.5"/>
{%- endif %}
</svg>
{%- endmacro %}

{#- Cinco estrellas rellenas (nota de Google) -#}
{% macro estrellas(clase="h-5 w-5") -%}
<span class="inline-flex gap-0.5 text-accent" aria-hidden="true">
  {%- for i in range(5) %}<svg class="{{ clase }}" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.8l2.8 5.7 6.3.9-4.6 4.4 1.1 6.3L12 17.1l-5.6 3 1.1-6.3-4.6-4.4 6.3-.9z"/></svg>{% endfor -%}
</span>
{%- endmacro %}

{#- Tira de fotos del trabajo, sin pies de foto -#}
{% macro galeria(nombres, columnas=4) -%}
<div class="grid grid-cols-2 gap-3 md:gap-5 {% if columnas == 3 %}lg:grid-cols-3{% else %}lg:grid-cols-4{% endif %}">
  {%- for nombre in nombres %}
  <div class="frame aspect-[4/5]">{{ foto(nombre, "(min-width: 1024px) 25vw, 50vw") }}</div>
  {%- endfor %}
</div>
{%- endmacro %}

{#- Lista con marca de verificación: título y una línea -#}
{% macro filas(items) -%}
<ul class="space-y-6">
  {%- for item in items %}
  <li class="flex gap-4">
    <span class="icono mt-0.5 !h-9 !w-9">{{ icono("check", "!h-5 !w-5") }}</span>
    <div>
      <h3>{{ item.t }}</h3>
      <p class="mt-1">{{ item.d }}</p>
    </div>
  </li>
  {%- endfor %}
</ul>
{%- endmacro %}
