---
layout: "layouts/base.njk"
permalink: "/404.html"
title: "Página no encontrada — Mudanzas C.Simon"
noindex: true
eleventyExcludeFromCollections: true
---
{%- from "macros.njk" import flecha with context -%}
    <section class="section">
      <div class="wrap">
        <div class="max-w-3xl" data-enter>
          <p class="label">Error 404</p>
          <h1 class="mt-4">Esta página no existe o se ha mudado</h1>
          <p class="lead mt-6">Puede que el enlace esté mal escrito o que la página ya no exista.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/" class="btn-primary">Ir al inicio {{ flecha() }}</a>
            <a href="tel:{{ site.telefono }}" class="btn-secondary">Llamar al {{ site.telefonoTexto }}</a>
          </div>
        </div>
        <div class="mt-16">
          <h2 class="section-head">Servicios de mudanza</h2>
          {% include "partials/servicios.njk" %}
        </div>
      </div>
    </section>
